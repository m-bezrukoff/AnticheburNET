#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

# Owned by AnticheburNET lifecycle, independent from the manually configured awg0.
start_service() {
    local config_path manifest plan iface table index
    config_path=$(uci -q get anticheburnet.settings.config_path) || return 1
    manifest="$config_path.awg.json"
    plan=$(ucode -L /usr/lib/anticheburnet /usr/lib/anticheburnet/singbox/awg.uc plan "$manifest") || return 1
    while IFS="$(printf '\t')" read -r iface table index; do
        [ -n "$iface" ] || continue
        procd_open_instance "$iface"
        procd_set_param command /usr/bin/anticheburnet-awg-subscription-run "$iface" "$manifest" "$table" "$index"
        procd_set_param file "$manifest"
        procd_set_param respawn 3600 5 5
        procd_set_param term_timeout 10
        procd_set_param stderr 1
        procd_close_instance
    done <<EOF
$plan
EOF
}
