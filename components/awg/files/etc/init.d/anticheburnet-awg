#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=11

start_service() {
    local enabled iface config_file subscription_url subscription_profile subscription_user_agent
    config_load anticheburnet_awg
    config_get_bool enabled settings enabled 0
    config_get iface settings interface awg0
    config_get config_file settings config_file /etc/anticheburnet/awg0.conf
    [ "$enabled" = 1 ] || return 0
    config_get subscription_url settings subscription_url ''
    config_get subscription_profile settings subscription_profile ''
    config_get subscription_user_agent settings subscription_user_agent Happ
    if [ -n "$subscription_url" ]; then
        if ! /usr/bin/anticheburnet-awg-import --output "$config_file" --profile "$subscription_profile" \
            --user-agent "$subscription_user_agent" -- "$subscription_url"; then
            logger -t anticheburnet-awg 'Subscription update failed; using the saved configuration if available'
        fi
    fi
    [ -s "$config_file" ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/anticheburnet-awg-run "$iface" "$config_file"
    procd_set_param file "$config_file"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 10
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger anticheburnet_awg; }
