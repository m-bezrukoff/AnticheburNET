#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=11

start_service() {
    local enabled iface config_file
    config_load forkop_awg
    config_get_bool enabled settings enabled 0
    config_get iface settings interface awg0
    config_get config_file settings config_file /etc/forkop/awg0.conf
    [ "$enabled" = 1 ] || return 0
    [ -s "$config_file" ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/forkop-awg-run "$iface" "$config_file"
    procd_set_param file "$config_file"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 10
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger forkop_awg; }
