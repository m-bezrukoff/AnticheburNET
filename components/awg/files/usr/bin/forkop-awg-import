#!/bin/sh
# Fetch a subscription into RAM, select one AWG profile, then replace the config.
set -eu
umask 077
profile=''
agent=Happ
output=/etc/forkop/awg0.conf
mode=extract
while [ "$#" -gt 0 ]; do
    case "$1" in
        --list) mode=list; shift ;;
        --profile|--user-agent|--output)
            [ "$#" -ge 2 ] || exit 2
            case "$1" in
                --profile) profile=$2 ;;
                --user-agent) agent=$2 ;;
                --output) output=$2 ;;
            esac
            shift 2
            ;;
        --) shift; break ;;
        -*) exit 2 ;;
        *) break ;;
    esac
done
[ "$#" = 1 ] || { echo 'Usage: forkop-awg-import [--list] [--profile NAME] [--user-agent AGENT] [--output FILE] HTTP(S)-URL' >&2; exit 2; }
backend_lib=${FORKOP_LIB:-/usr/lib/forkop}
component_lib=${FORKOP_COMPONENT_LIB:-/usr/lib}
parser="$component_lib/forkop-components/awg-subscription.uc"
uc() { ucode -L "$backend_lib" -L "$component_lib/forkop-components" "$parser" "$@"; }
url=$(uc url "$1")
work=$(mktemp -d /tmp/forkop-awg-import.XXXXXX)
candidate=''
cleanup() {
    [ -z "$candidate" ] || rm -f "$candidate"
    rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# No external decryptor or converter sees the private subscription URL.
if ! curl --fail --silent --location --proto '=http,https' --proto-redir '=http,https' \
    --connect-timeout 10 --max-time 60 --max-filesize 1048576 --user-agent "$agent" \
    --dump-header "$work/headers" --output "$work/body" --url "$url"; then
    echo 'AWG subscription download failed; current configuration was kept' >&2
    exit 1
fi
if [ "$mode" = list ]; then uc list "$work/body"; exit 0; fi
uc extract "$work/body" "$work/config" "$profile" "$work/headers"
# Validate the private key with the official AWG tools before storing anything.
ucode -L "$backend_lib" -L "$component_lib/forkop-components" -e '
let a=require("awg"); let fs=require("fs");
let config=a.prepare(ARGV[0]);
let key=match(config.device, /\nPrivateKey = ([^\n]+)/);
if(!key) die("AWG private key is required\n");
print(key[1],"\n");
' "$work/config" | awg pubkey >/dev/null
mkdir -p "$(dirname "$output")"
candidate=$(mktemp "$output.XXXXXX")
cat "$work/config" > "$candidate"
chmod 600 "$candidate"
mv -f "$candidate" "$output"
candidate=''
echo 'AmneziaWG profile imported; enable/restart forkop-awg to apply it'
