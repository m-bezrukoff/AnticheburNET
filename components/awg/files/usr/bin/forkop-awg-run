#!/bin/sh
set -eu
umask 077
iface=${1:-awg0}
config_file=${2:-/etc/forkop/awg0.conf}
case "$iface" in ''|*[!a-zA-Z0-9_-]*) exit 2 ;; esac
[ "${#iface}" -le 15 ] || exit 2
if ip link show dev "$iface" >/dev/null 2>&1; then
    echo "Interface $iface already exists; refusing to replace it" >&2
    exit 1
fi
# Reserved table for SO_BINDTODEVICE traffic only; the WAN default stays in main.
if [ -n "$(ip -4 route show table 311 2>/dev/null)$(ip -6 route show table 311 2>/dev/null)" ]; then
    echo 'Routing table 311 is occupied' >&2
    exit 1
fi
work=$(mktemp -d /var/run/forkop-awg.XXXXXX)
child=''
rule4=0
rule6=0
cleanup() {
    [ "$rule4" = 0 ] || ip -4 rule del priority 10400 oif "$iface" table 311 2>/dev/null || true
    [ "$rule6" = 0 ] || ip -6 rule del priority 10400 oif "$iface" table 311 2>/dev/null || true
    if [ -n "$child" ]; then
        kill "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
ucode -L /usr/lib/forkop /usr/lib/forkop-components/awg.uc prepare "$config_file" "$work/device.conf" > "$work/state.json"
amneziawg-go -f "$iface" &
child=$!
attempt=0
until [ -S "/var/run/amneziawg/$iface.sock" ]; do
    kill -0 "$child" 2>/dev/null || exit 1
    attempt=$((attempt + 1))
    [ "$attempt" -le 50 ] || { echo 'AWG socket readiness timeout' >&2; exit 1; }
    sleep 0.1
done
awg setconf "$iface" "$work/device.conf"
mtu=$(ucode -e 'let fs=require("fs"); print(json(fs.readfile(ARGV[0])).mtu);' "$work/state.json")
ip link set dev "$iface" mtu "$mtu" up
ucode -e 'let fs=require("fs"); for(let a in json(fs.readfile(ARGV[0])).addresses) print(a,"\n");' "$work/state.json" > "$work/addresses"
while IFS= read -r address; do
    ip address add "$address" dev "$iface"
    case "$address" in
        *:*) rule6=1 ;;
        *) rule4=1 ;;
    esac
done < "$work/addresses"
if [ "$rule4" = 1 ]; then
    ip -4 route add default dev "$iface" table 311
    ip -4 rule add priority 10400 oif "$iface" table 311
fi
if [ "$rule6" = 1 ]; then
    ip -6 route add default dev "$iface" table 311
    ip -6 rule add priority 10400 oif "$iface" table 311
fi
rm -f "$work/device.conf"
wait "$child"
