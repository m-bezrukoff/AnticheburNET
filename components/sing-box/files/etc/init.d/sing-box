#!/bin/sh /etc/rc.common
# AnticheburNET managed sing-box service for binary variants
USE_PROCD=1
START=99
STOP=10

start_service() {
    local enabled conffile
    config_load sing-box
    config_get_bool enabled main enabled 1
    config_get conffile main conffile /etc/sing-box/config.json
    [ "$enabled" = 1 ] && [ -s "$conffile" ] || return 0
    /usr/bin/sing-box check -c "$conffile" || return 1
    procd_open_instance
    procd_set_param command /usr/bin/sing-box run -c "$conffile"
    procd_set_param file "$conffile"
    procd_set_param respawn
    procd_set_param term_timeout 30
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger sing-box; }
