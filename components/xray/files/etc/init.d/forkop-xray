#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
    local enabled
    config_load forkop_xray
    config_get_bool enabled settings enabled 0
    [ "$enabled" = 1 ] || return 0
    [ -s /etc/forkop/xray/config.json ] || return 1
    /usr/bin/xray run -test -config /etc/forkop/xray/config.json >/dev/null || return 1
    procd_open_instance
    procd_set_param command /usr/bin/xray run -config /etc/forkop/xray/config.json
    procd_set_param file /etc/forkop/xray/config.json
    procd_set_param respawn
    procd_set_param term_timeout 30
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() { procd_add_reload_trigger forkop_xray; }
