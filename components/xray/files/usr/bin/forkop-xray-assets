#!/bin/sh
# Keep compressed geodata on flash; expand the verified data only in RAM.
set -eu
umask 077
source_dir=${FORKOP_XRAY_ASSET_SOURCE:-/usr/share/xray}
state_dir=${FORKOP_XRAY_ASSET_STATE:-/var/run/forkop-xray}
cache="$state_dir/assets"
mkdir -p "$state_dir"
attempt=0
until mkdir "$state_dir/asset-lock" 2>/dev/null; do
    attempt=$((attempt + 1))
    [ "$attempt" -le 100 ] || { echo 'Xray asset cache is locked' >&2; exit 1; }
    sleep 0.1
done
staged=''
cleanup() {
    [ -z "$staged" ] || rm -rf "$staged"
    rmdir "$state_dir/asset-lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
if [ -s "$cache/geoip.dat" ] && [ -s "$cache/geosite.dat" ] && \
    cmp -s "$source_dir/geodata.sha256" "$cache/.generation"; then
    printf '%s\n' "$cache"
    exit 0
fi
staged=$(mktemp -d "$state_dir/assets.XXXXXX")
tar -xzf "$source_dir/geodata.tar.gz" -C "$staged"
(cd "$staged"; sha256sum -c "$source_dir/geodata.sha256" >/dev/null)
cp "$source_dir/geodata.sha256" "$staged/.generation"
# This directory contains only the managed RAM cache, never user configuration.
if [ -e "$cache" ]; then mv "$cache" "$staged/previous"; fi
mv "$staged" "$cache"
staged=''
rm -rf "$cache/previous"
printf '%s\n' "$cache"
